import os
import tkinter as tk
from tkinter import ttk
import pandas as pd
from matplotlib.figure import Figure
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg


# Initialize Tkinter window
root = tk.Tk()
root.title('Sensor Dashboard - Lab 7 (Part B)')
root.geometry('800x600')


# Frame for Table View (from Part A)
table_frame = ttk.LabelFrame(root, text=" Recent Logged Records ")
table_frame.pack(fill="both", expand=True, padx=10, pady=5)


columns = ('timestamp', 'distance', 'motion')
tree = ttk.Treeview(table_frame, columns=columns, show='headings', height=6)
tree.heading('timestamp', text='Timestamp')
tree.heading('distance', text='Distance (cm)')
tree.heading('motion', text='Motion Flag')
tree.column('timestamp', width=250, anchor='center')
tree.column('distance', width=150, anchor='center')
tree.column('motion', width=100, anchor='center')
tree.pack(fill="both", expand=True, padx=5, pady=5)


# --- PART B: Matplotlib Embedded Chart Setup ---
plot_frame = ttk.LabelFrame(root, text=" Live Sensor Data Chart ")
plot_frame.pack(fill="both", expand=True, padx=10, pady=5)


# Create Matplotlib Figure and Subplot Axis
fig = Figure(figsize=(6, 3), dpi=100)
ax = fig.add_subplot(111)


# Embed Figure into Tkinter Canvas
canvas = FigureCanvasTkAgg(fig, master=plot_frame)
canvas.get_tk_widget().pack(fill="both", expand=True, padx=5, pady=5)


def refresh():
    # Load and render plot if log.csv exists
    if os.path.exists('log.csv'):
        try:
            df = pd.read_csv('log.csv')
            
            # Clear previous axis plot
            ax.clear()
            
            # Plot last 50 samples
            plot_data = df.tail(50)
            ax.plot(plot_data['distance'], marker='o', color='b', label='Distance (cm)')
            ax.set_title('Distance Measurements (Last 50 Samples)')
            ax.set_xlabel('Sample Index')
            ax.set_ylabel('Distance (cm)')
            ax.grid(True)
            ax.legend(loc='upper right')
            
            # Redraw canvas
            canvas.draw()
        except Exception as e:
            print(f"Error reading log.csv: {e}")


    # Schedule refresh() to run again after 1000 ms (1 second)
    root.after(1000, refresh)


# Start refresh loop and main application loop
refresh()
root.mainloop()
